<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- 审查报告 §5.2：敏感数据（Key 密文、Room、Timeline）不进云备份 -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <!-- 也禁用设备到设备迁移 -->
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
